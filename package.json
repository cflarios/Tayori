{
  "name": "interview-helper",
  "version": "0.2.0",
  "description": "Asistente de IA en tiempo real para reuniones, invisible al compartir pantalla",
  "license": "MIT",
  "author": "Cristian Ferla",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:win": "npm run build && node scripts/build-win.mjs",
    "build:portable": "npm run build && node scripts/build-win.mjs --win portable",
    "build:unpacked": "npm run build && node scripts/build-win.mjs --dir"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@electron-toolkit/preload": "3.0.2",
    "@electron-toolkit/utils": "4.0.0",
    "@google/genai": "^2.13.0",
    "ollama": "^0.6.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "2.0.0",
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
