{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "tests/**/*",
    // The worklet lives in the renderer but doesn't touch the DOM: it only
    // exports its source code as a string. It's included here so that
    // `pcm-worklet.test.ts` can import it and exercise the real worklet instead
    // of a copy.
    "src/renderer/audio-worker/pcm-worklet.ts",
    // Same case: parsing the code fences is pure logic with no DOM, and its
    // test lives with the rest.
    "src/renderer/overlay/answer-format.ts",
    // And the teleprompter's chunking, which is where it's really decided
    // whether a line can be said in one breath. No DOM and with its own test.
    "src/renderer/overlay/teleprompter.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@main/*": ["./src/main/*"]
    }
  }
}
