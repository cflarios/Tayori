{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "tests/**/*",
    // El worklet vive en el renderer pero no toca el DOM: sólo exporta su
    // código fuente como string. Se incluye aquí para que `pcm-worklet.test.ts`
    // pueda importarlo y ejercitar el worklet de verdad en lugar de una copia.
    "src/renderer/audio-worker/pcm-worklet.ts",
    // Mismo caso: parsear las vallas de código es lógica pura sin DOM, y su
    // test vive con los demás.
    "src/renderer/overlay/answer-format.ts",
    // Y el troceado del teleprompter, que es donde de verdad se decide si una
    // línea se puede decir de un tirón. Sin DOM y con test propio.
    "src/renderer/overlay/teleprompter.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@main/*": ["./src/main/*"]
    }
  }
}
